{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Firebase iOS 13 requires App Check 12, but Google Sign-In 10 requires App Check 11. Stay on Firebase 12 until Google Sign-In supports App Check 12.",
      "matchPackageNames": ["firebase/firebase-ios-sdk"],
      "allowedVersions": "<13"
    },
    {
      "description": "These are used only for the internal app, will be managed manually.",
      "matchPackageNames": [
        "com.google.cloud:google-cloud-translate",
        "io.grpc:grpc-bom"
      ],
      "enabled": false
    },
    {
      "description": "Exclude kotlinx-datetime versions with -compat suffix.",
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
      "allowedVersions": "!/-compat$/"
    },
    {
      "description": "Pin Ruby version to last known working version for fastlane compatibility.",
      "matchDepNames": ["ruby"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep Kotlin SwiftPM import versions, generated Package.swift dependencies, and Xcode package requirements in sync. depName (owner/repo) and datasource (github-tags) match the built-in swift manager, which groups the files onto the same branch.",
      "managerFilePatterns": [
        "/(^|/)core/ads/build\\.gradle\\.kts$/",
        "/(^|/)shared/build\\.gradle\\.kts$/",
        "/(^|/)iosApp/iosApp\\.xcodeproj/project\\.pbxproj$/"
      ],
      "matchStrings": [
        "url = url\\(\"https://github\\.com/(?<depName>[^\"]+?)(?:\\.git)?\"\\),\\s*version = exact\\(\"(?<currentValue>[0-9][^\"]*)\"\\)",
        "repositoryURL = \"https://github\\.com/(?<depName>[^\"]+?)(?:\\.git)?\";\\s*requirement = \\{\\s*kind = (?:upToNextMajorVersion|exactVersion);\\s*(?:minimumVersion|version) = (?<currentValue>[0-9][^;]*);"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
