TEAM_ID=MU6R4JU7G8

PRODUCT_NAME=BudgetPlus
PRODUCT_BUNDLE_IDENTIFIER=com.kevlina.budgetplus

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.6.2

FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)

// Retain Objective-C categories and dynamically discovered classes, including the Meta
// AdMob adapter. Do not also force-load its artifact path: SwiftPM links the framework
// from Build/Products, and loading both copies produces duplicate Objective-C symbols.
OTHER_LDFLAGS = $(inherited) -ObjC -framework shared
