<?xml version="1.0" encoding="utf-8"?>
<!--
    The static preview in the widget picker on Android 12 to 14, it mirrors the Glance widget with
    the sample items. Android 15+ shows the generated preview instead, see RecordGlanceWidget.
    Only the views supported by RemoteViews can be used.

    The rows overflow the widget and are clipped at its bottom edge, like the LazyColumn of the
    Glance widget. clipToOutline keeps the overflowing rows inside the rounded corners.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/record_widget_preview_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    tools:targetApi="31">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/record_widget_preview_header"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/record_widget_sample_book"
        android:textColor="@color/record_widget_preview_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!--
        A fixed height taller than the widget on purpose. With wrap_content, the row that doesn't
        fit is squeezed into the remaining space and its bottom padding clips the text, which
        leaves a gap at the bottom of the widget, e.g. in Chinese where the rows are taller. The
        fixed height measures every row at its full height, and the widget clips the overflow.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1000dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/record_widget_sample_coffee"
                android:textColor="@color/record_widget_preview_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_sample_category_food"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/record_widget_preview_light_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/record_widget_sample_lunch"
                android:textColor="@color/record_widget_preview_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_sample_category_food"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/record_widget_preview_light_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/record_widget_sample_commute"
                android:textColor="@color/record_widget_preview_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_sample_category_transport"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/record_widget_preview_light_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/record_widget_sample_groceries"
                android:textColor="@color/record_widget_preview_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_sample_category_daily"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/record_widget_preview_light_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/record_widget_sample_salary"
                android:textColor="@color/record_widget_preview_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_sample_category_salary"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/record_widget_preview_pill"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/record_widget_income"
                android:textColor="@color/record_widget_preview_light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
